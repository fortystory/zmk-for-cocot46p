#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&lt { tapping-term-ms = <150>; };

/ {
    combos {
        compatible = "zmk,combos";

        combo_setting {
            bindings = <&tog 3>;
            key-positions = <37 36 25 24>;
        };

        combo_ctrl_space {
            bindings = <&kp LC(F9)>;
            key-positions = <40 43>;
            layers = <0>;
        };

        combo_f8 {
            bindings = <&kp F8>;
            key-positions = <41 42>;
            layers = <0>;
        };

        combo_colon {
            bindings = <&kp COLON>;
            key-positions = <16 22>;
            layers = <0>;
        };

        combo_left_bracket_quotation {
            bindings = <&macro_bracket_and_quotation>;
            key-positions = <14 16>;
            layers = <0>;
            timeout-ms = <50>;
        };

        combo_quotation_right_bracket {
            bindings = <&macro_quotation_and_bracket>;
            key-positions = <19 21>;
            layers = <0>;
            timeout-ms = <50>;
        };

        combo_arraw {
            bindings = <&macro_arraw>;
            key-positions = <16 15>;
            layers = <2>;
            timeout-ms = <50>;
        };

        combo_arraw_eq {
            bindings = <&macro_arraw_eq>;
            key-positions = <4 3>;
            layers = <2>;
            timeout-ms = <50>;
        };

        combo_ctrl_f19 {
            bindings = <&kp LC(F19)>;
            key-positions = <26 27 28>;
            layers = <0>;
        };

        combo_ctrl_f20 {
            bindings = <&kp LC(F20)>;
            key-positions = <2 3 4>;
            layers = <0>;
        };

        combo_middle_click {
            bindings = <&mkp MCLK>;
            key-positions = <31 30>;
            layers = <0 1 4 7>;
        };

        combo_s_e {
            bindings = <&macro_se>;
            key-positions = <14 3>;
            layers = <0>;
        };

        combo_l_i {
            bindings = <&macro_li>;
            key-positions = <21 8>;
            layers = <0>;
        };

        combo_fj {
            bindings = <&kp LS(SPACE)>;
            key-positions = <16 19>;
            layers = <0>;
        };

        combo_ctrl_f9 {
            bindings = <&kp LC(F9)>;
            key-positions = <39 44>;
            layers = <0>;
        };

        combo_d_space {
            bindings = <&macro_d_space>;
            key-positions = <15 40>;
            layers = <0>;
        };

        combo_enter {
            bindings = <&kp ENTER>;
            key-positions = <16 15 14>;
            layers = <0>;
        };

        combo_eq {
            bindings = <&kp EQUAL>;
            key-positions = <43 16>;
            layers = <0>;
            timeout-ms = <50>;
        };

        combo_dollar {
            bindings = <&kp DOLLAR>;
            key-positions = <43 4>;
            layers = <0>;
            timeout-ms = <250>;
        };

        combo_to_origin {
            bindings = <&to 7>;
            key-positions = <38 45>;
            layers = <0>;
        };

        combo_to_qwerty {
            bindings = <&to 0>;
            key-positions = <38 45>;
            layers = <7>;
        };

        combo_ctrl_enter {
            bindings = <&kp LC(ENTER)>;
            key-positions = <16 15 14>;
            layers = <5>;
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <250>;
            flavor = "tap-preferred";
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
        };

        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTO_SHIFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <135>;
            quick-tap-ms = <0>;
        };
    };

    macros {
        macro_bracket_and_quotation: macro_bracket_and_quotation {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp SQT>;
            label = "MACRO_BRACKET_AND_QUOTATION";
        };

        macro_quotation_and_bracket: macro_quotation_and_bracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT &kp RIGHT_BRACKET>;
            label = "MACRO_QUOTATION_AND_BRACKET";
        };

        macro_arraw: macro_arraw {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GREATER_THAN>;
            label = "MACRO_ARRAW";
        };

        macro_arraw_eq: macro_arraw_eq {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GREATER_THAN>;
            label = "MACRO_ARRAW_EQ";
        };

        macro_se: macro_se {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp E>;
            label = "MACRO_SE";
        };

        macro_li: macro_li {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp L &kp I>;
            label = "MACRO_LI";
        };

        macro_d_space: macro_d_space {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp D &kp SPACE>;
            label = "MACRO_D_SPACE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty {
            bindings = <
&kp GRAVE       &kp Q  &kp W           &kp E         &kp R             &kp T                              &kp Y        &kp U              &kp I          &kp O            &kp P      &kp BSPC
&kp ESC         &kp A  &hm LEFT_ALT S  &hm LCTRL D   &hm LEFT_SHIFT F  &lt 4 G                            &kp H        &hm RIGHT_SHIFT J  &hm RCTRL K    &hm RIGHT_ALT L  &kp SEMI   &kp SQT
&kp LEFT_SHIFT  &kp Z  &kp X           &kp C         &kp V             &kp B        &mkp LCLK  &mkp RCLK  &kp N        &kp M              &kp COMMA      &kp DOT          &kp SLASH  &kp DELETE
                                       &kp LEFT_ALT  &lt 5 UNDERSCORE  &lt 1 SPACE  &kp TAB    &kp ENTER  &lt 2 SPACE  &lt 6 MINUS        &kp RIGHT_ALT  &kp C_MUTE
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
            label = "cocot46p";
        };

        guide {
            bindings = <
&none    &none     &none     &none      &none      &none                           &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE   &none              &kp BACKSPACE
&kp ESC  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none                           &kp LEFT_ARROW  &kp DOWN_ARROW        &kp UP_ARROW           &kp RIGHT_ARROW   &mt HOME PAGE_UP   &kp DOUBLE_QUOTES
&none    &none     &none     &none      &none      &none      &mkp MB4  &mkp MB5   &kp LESS_THAN   &kp LBKT              &kp RBKT               &kp GREATER_THAN  &mt END PAGE_DOWN  &kp DEL
                             &none      &none      &kp SPACE  &none     &kp ENTER  &kp SPACE       &kp C_PREV            &kp C_NEXT             &kp C_PAUSE
            >;

            label = "HJKL";
            sensor-bindings = <&inc_dec_kp C_PREV C_NEXT>;
        };

        symbols {
            bindings = <
&kp GRAVE  &kp AMPERSAND    &kp AT_SIGN   &kp POUND  &kp DOLLAR            &kp PERCENT                   &none           &none      &none      &none      &none     &kp BSPC
&kp ESC    &kp EXCLAMATION  &kp ASTERISK  &kp MINUS  &kp EQUAL             &kp TILDE                     &none           &kp RSHFT  &kp RCTRL  &kp RALT   &kp RGUI  &kp ENTER
&kp LSHFT  &kp CARET        &kp FSLH      &kp PIPE   &kp NON_US_BACKSLASH  &kp UNDERSCORE  &none  &none  &kp UNDERSCORE  &kp BSLH   &kp PIPE   &kp MINUS  &kp FSLH  &kp DEL
                                          &none      &none                 &none           &none  &none  &none           &none      &none      &none
            >;

            label = "!@#$";
            sensor-bindings = <&inc_dec_kp C_NEXT C_PREV>;
        };

        Setting {
            bindings = <
&rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &ext_power EP_ON                   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
&rgb_ug RGB_HUI  &rgb_ug RGB_HUD  &trans           &trans           &trans           &ext_power EP_OFF                  &trans        &trans        &trans        &trans        &trans        &bt BT_CLR_ALL
&trans           &trans           &trans           &trans           &trans           &bootloader        &trans  &trans  &bootloader   &trans        &trans        &trans        &sys_reset    &trans
                                                   &trans           &trans           &trans             &trans  &trans  &trans        &trans        &trans        &trans
            >;

            label = "setting";
        };

        Snipe {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &mkp RCLK  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans  &trans
            >;

            label = "Snipe";
        };

        number {
            bindings = <
&none    &kp LC(Q)           &kp LC(W)           &kp LC(E)        &kp LC(R)             &kp LC(T)                   &kp ASTERISK  &kp N7   &kp N8  &kp N9  &kp EQUAL    &kp BSPC
&kp ESC  &hm LEFT_WIN LC(A)  &hm LEFT_ALT LC(S)  &hm LCTRL LC(D)  &hm LEFT_SHIFT LC(F)  &kp LC(G)                   &kp MINUS     &kp N4   &kp N5  &kp N6  &kp PERCENT  &kp ENTER
&none    &kp LC(Z)           &kp LC(X)           &kp LC(C)        &kp LC(V)             &kp LC(B)  &none    &none   &kp KP_PLUS   &kp N1   &kp N2  &kp N3  &kp FSLH     &none
                                                 &none            &none                 &none      &kp TAB  &kp N0  &none         &kp DOT  &none   &none
            >;

            label = "12345";
        };

        fn {
            bindings = <
&none      &kp F12  &kp F11  &kp F10   &kp F9     &none                &none  &none      &none      &none     &none     &none
&none      &kp F4   &kp F3   &kp F2    &kp F1     &none                &none  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
&kp LSHFT  &kp F8   &kp F7   &kp F6    &kp F5     &none  &none  &none  &none  &none      &none      &none     &none     &none
                             &kp LALT  &kp LCTRL  &none  &none  &none  &none  &none      &none      &none
            >;

            label = "F123";
        };

        origin {
            bindings = <
&kp GRAVE  &kp Q  &kp W  &kp E  &kp R           &kp T                           &kp Y      &kp U      &kp I      &kp O       &kp P     &kp BSPC
&kp ESC    &kp A  &kp S  &kp D  &kp F           &kp G                           &kp H      &kp J      &kp K      &kp L       &kp SEMI  &kp APOS
&kp LSHFT  &kp Z  &kp X  &kp C  &kp V           &kp B      &mkp MB1  &mkp MB2   &kp N      &kp M      &kp COMMA  &kp DOT     &kp FSLH  &kp DELETE
                         &none  &kp UNDERSCORE  &kp SPACE  &kp TAB   &kp ENTER  &kp SPACE  &kp MINUS  &none      &kp C_MUTE
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
            label = "origin";
        };
    };
};
